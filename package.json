{
  "name": "nook-kampala-concept",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "images": "py -P scripts/optimize-images.py",
    "verify": "node scripts/verify.mjs",
    "deploy": "npm run build && npx wrangler@4 pages deploy dist --project-name nook-kampala-concept --branch main"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.64.1",
    "typescript": "~5.9",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
